pipeline {
    agent any

    environment {
        EMAIL_RECIPIENTS = 'shubham.aggarwal1@tothenew.com'
        AWS_REGION = 'us-east-1'  // Change as needed
        AWS_ACCOUNT_ID = '148761653007'  // Replace with your account ID
        ECR_REPOSITORY = 'final-project/react-app'  // Change repository name
        ROLE_ARN = "arn:aws:iam::${AWS_ACCOUNT_ID}:role/Jenkins_Push_Pull"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Get Build Info') {
            steps {
                script {
                    env.BUILD_DATE = sh(script: "date +%Y%m%d", returnStdout: true).trim()
                    env.IMAGE_TAG = "Main-${env.BUILD_NUMBER}-${env.BUILD_DATE}"
                    echo "Using Image Tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Assume AWS Role') {
            steps {
                script {
                    def creds = sh(script: "aws sts assume-role --role-arn ${env.ROLE_ARN} --role-session-name JenkinsECRAccess --query 'Credentials' --output json", returnStdout: true).trim()
                    def jsonCreds = readJSON text: creds
                    env.AWS_ACCESS_KEY_ID = jsonCreds.AccessKeyId
                    env.AWS_SECRET_ACCESS_KEY = jsonCreds.SecretAccessKey
                    env.AWS_SESSION_TOKEN = jsonCreds.SessionToken
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                script {
                    sh """
                    echo "Building Docker Image..."
                    docker build -t ${env.ECR_REPOSITORY}:${env.IMAGE_TAG} .

                    echo "Logging into AWS ECR..."
                    aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                    echo "Tagging Docker Image..."
                    docker tag ${env.ECR_REPOSITORY}:${env.IMAGE_TAG} ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${env.IMAGE_TAG}

                    echo "Pushing Docker Image to ECR..."
                    docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${env.IMAGE_TAG}
                    """
                }
            }
        }
    }

     post {
        success {
            echo "Pipeline execution successful. Sending notification email..."
            emailext (
                subject: "✅ Image Build & Deployment Successful: ${env.IMAGE_TAG}",
                body: "The application image has been successfully built and pushed to AWS ECR.\n\n" +
                      "Image Repository: ${ECR_REPOSITORY}\n" +
                      "Image Tag: ${IMAGE_TAG}\n" +
                      "AWS Account: ${AWS_ACCOUNT_ID}\n\n" +
                      "Please verify the image in the AWS console before proceeding with deployment.",
                to: "${env.EMAIL_RECIPIENTS}",
                from: "${env.EMAIL_SENDER}"
            )
        }

        failure {
            echo "Pipeline execution failed. Sending failure notification email..."
            emailext (
                subject: "❌ Image Build & Deployment Failed",
                body: "The Jenkins pipeline for building and pushing the application image has failed.\n\n" +
                      "Build Number: ${env.BUILD_NUMBER}\n" +
                      "Check the Jenkins logs for details and take appropriate action.",
                to: "${env.EMAIL_RECIPIENTS}",
                from: "${env.EMAIL_SENDER}"
            )
        }
    }
}
